# Server-only settings. Never commit real secrets.
# Lovable normally provisions LOVABLE_API_KEY for the connected project.
LOVABLE_API_KEY=
# Required to protect billable research requests. Set in Lovable server secrets.
ASTRA_ACCESS_CODE=
ASTRA_SESSION_SECRET=
# Optional: use Perplexity search excerpts instead of free news headlines.
PERPLEXITY_API_KEY=
# Per-instance hourly research unit fuse; not a distributed billing cap.
ASTRA_AI_HOURLY_UNITS=40
