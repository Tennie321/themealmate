# Server-only environment names for local development.
# Do not fill this file with real credentials or commit actual .env files.
# Automatically managed by Lovable Cloud for hosted projects:
LOVABLE_API_KEY=
# Required for protected AI usage (server-side only):
ASTRA_ACCESS_CODE=
ASTRA_SESSION_SECRET=
# Optional live search:
PERPLEXITY_API_KEY=
# Optional rate fuse (request units per hour, default 40):
ASTRA_AI_HOURLY_UNITS=40

# Optional remote Playwright browser worker (server-only public WSS endpoint):
BROWSER_BRIDGE_WS_URL=
# Worker deployment uses the same ASTRA_SESSION_SECRET and exact Astra origin:
# APP_ORIGIN=https://astra.example.com

# Independent HMAC signing secret shared ONLY with the remote browser worker (32+ chars):
BROWSER_BRIDGE_SECRET=
