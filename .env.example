# Server-only environment names for local development.
# Do not fill this file with real credentials or commit actual .env files.
# Automatically managed by Lovable Cloud for hosted projects:
LOVABLE_API_KEY=
# Required for protected AI usage (server-side only):
ASTRA_ACCESS_CODE=
ASTRA_SESSION_SECRET=
# Optional live search:
PERPLEXITY_API_KEY=
# Optional rate fuse (request units per hour, default 40):
ASTRA_AI_HOURLY_UNITS=40

# Optional remote ChatGPT browser service (never expose the secret via VITE_).
# Must be an independent random 32+ character secret, shared by web server + browser worker.
BROWSER_BRIDGE_SECRET=
# Comma-separated exact Astra origins allowed by the browser service, no wildcard.
BROWSER_ALLOWED_ORIGIN=http://localhost:3000
# Public browser worker HTTPS origin if not served under the same /browser-api proxy.
# This URL is safe to expose, but is NOT the worker signing secret.
VITE_BROWSER_BRIDGE_URL=
