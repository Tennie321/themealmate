# Server-only environment names for local development.
# Do not fill this file with real credentials or commit actual .env files.
# Automatically managed by Lovable Cloud for hosted projects:
LOVABLE_API_KEY=
# Required for protected AI usage (server-side only):
ASTRA_ACCESS_CODE=
ASTRA_SESSION_SECRET=
# Optional live search:
PERPLEXITY_API_KEY=
# Optional rate fuse (request units per hour, default 40):
ASTRA_AI_HOURLY_UNITS=40

# Remote browser add-on (server-only; share the secret with the browser container):
ASTRA_BROWSER_SECRET=
# Optional public wss:// URL of the separately deployed browser worker; omit if same-origin reverse proxied.
ASTRA_BROWSER_PUBLIC_WS_URL=
# In the browser worker only: exact deployed Astra origin, e.g. https://astra.example
ASTRA_BROWSER_ORIGIN=
